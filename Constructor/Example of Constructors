class Kurti{
    String brand;
    String material;
    int price;
    
    Kurti(String b, String m, int p){
        brand = b;
        material = m;
        price = p;
    }
    void display(){
        System.out.println(brand + " " + material + " " + price);
    }
}

public class Main{
    public static void main(String[] args) {
        Kurti k1 = new Kurti("Libas" , "Cotton", 5000);
        Kurti k2 = new Kurti("Sabhyata" , "Silk", 7000);
        
        k1. display();
        k2.display(); 
}
}
