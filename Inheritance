class Vehicle{                //class
String brand;
}
Vehicle(String b){            //constructor 
brand = b;
}
void displayBrand(){
 System.out.println("Brand: " + brand);
}
}
class Car extends Vehicle{     //child class    (Inheritance)
int price;

Car(String b, int p){
super(b);                    //Call parent class constructor
price = p;
void displayPrice() {

  System.out.println("Price: " + price);
    }
}

public class Main {

    public static void main(String[] args) {

        Car c1 = new Car("BMW", 1000);

        c1.displayBrand();

        c1.displayPrice();
    }
}

